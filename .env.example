# Auth is Entra ID: just run `az login`. No API key needed.
# AZURE_OPENAI_ENDPOINT=https://ai-adoption-coe.services.ai.azure.com/openai/v1/
# Must be a vision-capable deployment. DeepSeek-V4-Pro is text-only and will fail.
# AZURE_OPENAI_DEPLOYMENT=gpt-5.4

# Optional fallback workbooks for the PO folder page (full paths). You normally choose
# both Excel files on the page itself; a file chosen there always wins over these.
# MASTER_FILE=C:\path\to\master dump.xlsx
# ANNEXURE_FILE=C:\path\to\Travel Annexure.xlsx

# Receipts read in parallel (default 4)
# RECEIPT_WORKERS=4

# Corporate SSL inspection without truststore: path to your root CA PEM
# CLAUDE_CA_BUNDLE=C:\path\to\corp-root-ca.pem
